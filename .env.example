# Kopiera till .env.local och fyll i värdena (.env.local är gitignorerad).
# Värdena finns i Supabase Dashboard -> Project Settings -> API Keys / Data API.
# Bara PUBLIKA värden här: URL + publishable key. Aldrig secret/service_role.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
